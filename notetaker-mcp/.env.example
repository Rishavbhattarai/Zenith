GEMINI_API_KEY=

INVENTORY_SERVICE_URL=http://localhost:8001
INGESTION_MESH_URL=http://localhost:8080
FIELD_SERVICE_USERNAME=field-tech-service
FIELD_SERVICE_PASSWORD=field-tech-demo-pw

# In production, set this to match your deployed frontend origin(s), e.g.
# https://.*\.vercel\.app -- the field-app calls this service directly
# from the browser, so a wrong/missing value here means CORS blocks it.
ALLOWED_ORIGIN_REGEX=http://localhost:\d+

# Only needed if docs/runbooks isn't a sibling of this directory (e.g. a
# container built with a different layout than the monorepo dev setup).
# RUNBOOKS_DIR=/docs/runbooks
